{
  "name": "firefighter-alarm",
  "version": "1.0.0",
  "description": "Automated Dispatch Location and Printing System",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:unit": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e --config vitest.e2e.config.ts",
    "test:e2e:watch": "vitest test/e2e --config vitest.e2e.config.ts",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@effect/platform": "latest",
    "@effect/platform-node": "latest",
    "@effect/schema": "latest",
    "@effect/sql": "^0.46.0",
    "@effect/sql-sqlite-bun": "^0.47.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "latest",
    "imapflow": "^1.1.1",
    "ipp": "^2.0.1",
    "lucide-react": "^0.552.0",
    "next": "^15.1.6",
    "playwright": "^1.56.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.66.0",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@effect/vitest": "^0.26.0",
    "@eslint/eslintrc": "^3.3.1",
    "@types/ipp": "^2.0.5",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/ui": "^3.2.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "eslint-config-prettier": "^10.0.1",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "shadcn": "^3.5.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
