# Email Configuration
EMAIL_HOST=imap.example.com
EMAIL_PORT=993
EMAIL_USER=dispatch@example.com
EMAIL_PASSWORD=your_password_here
MONITORED_EMAIL=dispatch@example.com
EMAIL_POLLING_INTERVAL_MS=5000

# Filter Configuration (subjectContains and subjectRegex are mutually exclusive)
FILTER_SENDER_EMAIL=dispatch-center@example.com
FILTER_SUBJECT_CONTAINS=DISPATCH
# FILTER_SUBJECT_REGEX=^DISPATCH.*

# Station Configuration
STATION_NAME=Fire Station 1
STATION_LAT=49.947014
STATION_LON=17.885027

# CUPS Printer Configuration
CUPS_HOST=localhost
CUPS_PORT=631
CUPS_PRINTER_NAME=FireDispatchPrinter
CUPS_RETRY_ATTEMPTS=3
CUPS_RETRY_DELAY_MS=30000

# Print Format (single-page or two-page)
PRINT_FORMAT=single-page

# Map Service Configuration (Mapy.cz)
MAP_API_KEY=your_mapycz_api_key_here
MAP_PROVIDER=mapycz
MAP_TIMEOUT_MS=10000
MAP_WIDTH=800
MAP_HEIGHT=600
MAP_MAPSET=basic
MAP_ROUTE_TYPE=car_fast

# Database Configuration
DATABASE_PATH=./data/dispatch.db
