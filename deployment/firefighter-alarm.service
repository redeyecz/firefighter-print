[Unit]
Description=Firefighter Alarm System
Documentation=https://github.com/yourorg/firefighter-alarm
After=network.target cups.service

[Service]
Type=simple
User=firefighter
Group=firefighter
WorkingDirectory=/opt/firefighter-alarm
Environment="NODE_ENV=production"
EnvironmentFile=/opt/firefighter-alarm/.env
ExecStart=/usr/bin/bun run start
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=firefighter-alarm

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/firefighter-alarm/data /opt/firefighter-alarm/logs
CapabilityBoundingSet=

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
